# Normaliza fim de linha: LF no repositório, exceto onde o Windows exige CRLF.
* text=auto eol=lf

*.md       text eol=lf
*.json     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.py       text eol=lf
*.sh       text eol=lf
*.txt      text eol=lf
VERSION    text eol=lf

# PowerShell em Windows prefere CRLF (não é obrigatório, mas evita ruído em editor antigo)
*.ps1      text eol=crlf
*.cmd      text eol=crlf

# Binários: não tocar
*.zip      binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.pdf      binary
*.exe      binary
