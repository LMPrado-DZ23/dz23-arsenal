{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dz23.local/schema/spec.schema.json",
  "title": "DZ23 Spec manifest v1",
  "description": "Estrutura de uma especificação executável mínima. Valida forma, não semântica.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "spec_id", "requirements", "tasks"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "spec_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]{1,63}$"},
    "title": {"type": "string", "minLength": 1},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/requirement"}
    },
    "tasks": {
      "type": "array",
      "items": {"$ref": "#/$defs/task"}
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "acceptance", "priority"],
      "properties": {
        "id": {"type": "string", "pattern": "^REQ-[0-9]{3,}$"},
        "title": {"type": "string", "minLength": 3},
        "priority": {"type": "string", "enum": ["P0", "P1", "P2", "P3"]},
        "status": {
          "type": "string",
          "enum": ["PROPOSED", "APPROVED", "IMPLEMENTED", "VERIFIED", "BLOCKED", "NOT_TESTED", "OUT_OF_SCOPE"]
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "criterion"],
            "properties": {
              "id": {"type": "string", "pattern": "^CA-[0-9]{3,}-[0-9]+$"},
              "criterion": {"type": "string", "minLength": 5},
              "kind": {"type": "string", "enum": ["happy", "error", "edge", "nfr"]}
            }
          }
        },
        "tasks": {"type": "array", "items": {"type": "string", "pattern": "^TASK-[0-9]{3,}$"}}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "depends_on"],
      "properties": {
        "id": {"type": "string", "pattern": "^TASK-[0-9]{3,}$"},
        "title": {"type": "string", "minLength": 3},
        "estimate": {"type": "string", "enum": ["S", "M", "L", "XL"]},
        "depends_on": {
          "type": "array",
          "items": {"type": "string", "pattern": "^TASK-[0-9]{3,}$"}
        },
        "verify": {"type": "string"}
      }
    }
  }
}
