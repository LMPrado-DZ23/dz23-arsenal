# Dependências de terceiros
node_modules/
bower_components/
# `vendor/` e a pasta de codigo de terceiro INSTALADO (npm/pip), regeneravel do manifesto -- por isso
# fica fora do versionamento. O acervo de dados incorporado sob licenca e conteudo do arsenal, nao
# dependencia, entao mora fora de vendor/: ver dados-design/.
vendor/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Build e distribuição
dist/
build/
out/
target/
*.o
*.obj
*.exe
*.dll
*.so
*.dylib

# Ambiente e segredos
.env
.env.*
!.env.example
*.pem
*.key
secrets.*
credentials.*

# Editores e SO
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/settings.json.example
*.swp
*~

# Logs e temporários
*.log
tmp/
temp/
.cache/

# Artefatos de skill que não devem ir para o repo
*.zip
!external/*.zip
_bak/
.bak-*/
_antigos/
_sources/

# Binários grandes de análise
*.bin
*.img
*.elf
*.uf2
*.dtb

# Artefato do quality-gate: contagem da ultima execucao real
.gate-contagem
# Artefato do run-evals --report: contagem medida de evals (fonte unica de numero)
.evals-contagem.json

# Lockfiles npm nao sao versionados neste repo (precedente:
# mcp/dz23-subagents-universal-mcp). O CI instala dependencias antes de testar,
# entao a reprodutibilidade vem das versoes no package.json, nao de um lock gerado local.
mcp/*/package-lock.json
